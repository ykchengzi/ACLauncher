<Application
    x:Class="ACLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 3 原生控件资源 -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                自定义画刷：不再使用 ThemeDictionaries。
                Application 级主题字典只跟随 Application.RequestedTheme 解析，
                运行时切换主题时不会重新求值（导航栏会残留深色）。
                改为单实例 SolidColorBrush，由 App.ApplyPalette 直接改 Color，
                所有引用（StaticResource / ThemeResource）立即同步更新。
            -->
            <SolidColorBrush x:Key="McOrangeDeepBrush" Color="#C25E0E" />
            <SolidColorBrush x:Key="McOrangeFaintBrush" Color="#FDF4E9" />
            <SolidColorBrush x:Key="TealAccentBrush" Color="#0E7C7B" />
            <SolidColorBrush x:Key="WarmCreamBrush" Color="#FBF4EC" />
            <SolidColorBrush x:Key="InfoTagBorderBrush" Color="#F3D9BC" />
            <SolidColorBrush x:Key="InfoTagTextBrush" Color="#C25E0E" />

            <!-- 表面层级（浅色默认；深色由 ApplyPalette 改写） -->
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#EEEEEE" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FBF4EC" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F3F3F3" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E6E0D8" />

            <!-- ============ 启动器主题（橙猫橙主色 + 暖米衬托，浅色） ============ -->

            <!-- 全局系统强调色覆盖为橙猫橙：所有页面的强调按钮 / 开关 / 列表选中 / 徽章随之统一 -->
            <Color x:Key="SystemAccentColor">#E8791E</Color>
            <Color x:Key="SystemAccentColorLight1">#F0913F</Color>
            <Color x:Key="SystemAccentColorLight2">#F5A75F</Color>
            <Color x:Key="SystemAccentColorLight3">#FABF87</Color>
            <Color x:Key="SystemAccentColorDark1">#C96612</Color>
            <Color x:Key="SystemAccentColorDark2">#A95409</Color>
            <Color x:Key="SystemAccentColorDark3">#8A4405</Color>

            <!-- 橙猫品牌橙（品牌点缀：横幅、头像、品牌图标） -->
            <Color x:Key="McOrangeColor">#E8791E</Color>
            <SolidColorBrush x:Key="McOrangeBrush" Color="{StaticResource McOrangeColor}" />
            <SolidColorBrush x:Key="McOrangeLightBrush" Color="#FFB25E" />


            <!-- 服务器在线状态：在线绿 / 离线红 -->
            <SolidColorBrush x:Key="ServerOnlineBrush" Color="#3BA55D" />
            <SolidColorBrush x:Key="ServerOfflineBrush" Color="#E74C3C" />

            <!-- 启动按钮保持我的世界品牌绿（启动 = 经典绿色，区别于界面主色） -->
            <Color x:Key="McGreenColor">#3C8527</Color>
            <Color x:Key="McGreenHoverColor">#4CA83A</Color>
            <Color x:Key="McGreenPressedColor">#2E6B21</Color>
            <Color x:Key="McGreenDisabledColor">#9DBF93</Color>
            <SolidColorBrush x:Key="McGreenBrush" Color="{StaticResource McGreenColor}" />

            <!-- 顶部横幅渐变（暖橙 → 深橙） -->
            <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F49B36" Offset="0.0" />
                <GradientStop Color="#E8791E" Offset="0.55" />
                <GradientStop Color="#C25E0E" Offset="1.0" />
            </LinearGradientBrush>


            <!-- 内页标题左侧的橙色装饰条（各页面统一品牌感） -->
            <Style x:Key="PageTitleAccentBar" TargetType="Rectangle">
                <Setter Property="Width" Value="5" />
                <Setter Property="Height" Value="24" />
                <Setter Property="RadiusX" Value="2.5" />
                <Setter Property="RadiusY" Value="2.5" />
                <Setter Property="Fill" Value="{StaticResource McOrangeBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 大启动按钮（绿色，含悬停 / 按下 / 禁用状态） -->
            <Style x:Key="MinecraftLaunchButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Height" Value="52" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="BackgroundBorder"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Background="{StaticResource McGreenBrush}" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  FontWeight="{TemplateBinding FontWeight}"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BackgroundBorder"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="{StaticResource McGreenHoverColor}" Duration="0:0:0.1" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BackgroundBorder"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="{StaticResource McGreenPressedColor}" Duration="0:0:0.05" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BackgroundBorder"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="{StaticResource McGreenDisabledColor}" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
