<Page
    x:Class="ACLauncher.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="24" />
        </Style>
    </Page.Resources>

    <Grid Padding="24">
        <ScrollViewer>
            <StackPanel Spacing="20" Margin="0,24,0,24">
                <!-- 标题 -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,8">
                    <Rectangle Style="{StaticResource PageTitleAccentBar}" />
                    <TextBlock Text="关于" Style="{ThemeResource TitleTextBlockStyle}" />
                </StackPanel>

                <!-- 品牌卡片 -->
                <Border Style="{StaticResource CardStyle}" Padding="32,28">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <Border Width="96" Height="96" CornerRadius="22"
                                HorizontalAlignment="Center">
                            <Image x:Name="BrandIcon" Width="96" Height="96"
                                   Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="ACLauncher" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="v0.99.3-beta 内测版"
                                   FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource McOrangeDeepBrush}" />
                        <TextBlock FontSize="16"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                            <Run Text="一个普普通通的启动器" />
                            <Run Text="（但不过可能更适合橙猫服(?)）" TextDecorations="Strikethrough" />
                        </TextBlock>
                        <TextBlock x:Name="VersionText"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="检查更新" HorizontalAlignment="Center" MinWidth="120"
                                Margin="0,4,0,0"
                                Click="CheckUpdate_Click" />
                        <TextBlock x:Name="UpdateStatusText"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- 服务器信息 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="服务器信息" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="服务器地址"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="mc.ambercat.top" FontWeight="SemiBold" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 致谢 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="致谢" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="感谢 SadEPa 制作整合包。" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="开源组件：Java Launch Wrapper（MIT License，Copyright (c) 2022 00ll00），用于修复部分系统下 Java 启动参数的编码问题。" />
                        <TextBlock Text="ACLauncher © 橙猫生存服务器。Minecraft 是 Mojang Studios 的商标，与本项目无关。"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
