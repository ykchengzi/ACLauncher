<Page
    x:Class="ACLauncher.Views.VersionDownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:ACLauncher.Services"
    xmlns:local="using:ACLauncher.Views"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="SectionNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="SectionCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="12,10,0,4" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,18,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
            <Rectangle Style="{StaticResource PageTitleAccentBar}" />
            <TextBlock Text="下载" Style="{ThemeResource TitleTextBlockStyle}" />
        </StackPanel>

        <!-- ===== 左导航 + 右内容 ===== -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：分区导航 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                <StackPanel Spacing="2">
                    <TextBlock Text="游戏版本" Style="{StaticResource SectionCaptionStyle}" />
                    <Button x:Name="NavGame" Tag="Game" Style="{StaticResource SectionNavButtonStyle}" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7FC;" FontSize="16" />
                            <TextBlock Text="游戏" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavPack" Tag="Pack" Style="{StaticResource SectionNavButtonStyle}" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7B8;" FontSize="16" />
                            <TextBlock Text="整合包" FontSize="14" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="附加内容" Style="{StaticResource SectionCaptionStyle}" />
                    <Button x:Name="NavMod" Tag="Mod" Style="{StaticResource SectionNavButtonStyle}" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE950;" FontSize="16" />
                            <TextBlock Text="模组" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavResourcepack" Tag="Resourcepack" Style="{StaticResource SectionNavButtonStyle}" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                            <TextBlock Text="资源包" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavShader" Tag="Shader" Style="{StaticResource SectionNavButtonStyle}" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE706;" FontSize="16" />
                            <TextBlock Text="光影" FontSize="14" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 右：内容区（整合包下载源选择在对应卡片内） -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="1">

                    <!-- ===== 游戏：官方版本全量列表 ===== -->
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.GameVisible, Mode=OneWay}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="16">
                                <StackPanel>
                                    <TextBlock Text="游戏" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.RepoInfo, Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="VanillaCategoryBox"
                                          Header="分类"
                                          MinWidth="140"
                                          HorizontalAlignment="Right"
                                          IsEditable="False"
                                          SelectedIndex="0"
                                          SelectionChanged="VanillaCategory_SelectionChanged">
                                    <ComboBoxItem Content="正式版" />
                                    <ComboBoxItem Content="快照" />
                                    <ComboBoxItem Content="旧版" />
                                </ComboBox>
                            </Grid>

                            <ListView Grid.Row="1" x:Name="VanillaList"
                                      ItemsSource="{x:Bind ViewModel.VanillaVersions, Mode=OneWay}"
                                      SelectionMode="Single"
                                      SelectionChanged="VanillaList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="services:DownloadableVersion">
                                        <Grid ColumnSpacing="10" Padding="2,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind MainText}"
                                                           FontSize="15" FontWeight="Bold"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Note}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="已安装"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                       Visibility="{x:Bind InstalledVisibility, Mode=OneTime}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Button Grid.Row="2"
                                    Content="下载所选游戏版本"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Height="42"
                                    Click="DownloadVanilla_Click" />
                        </Grid>
                    </Border>

                    <!-- ===== 整合包（橙猫服官方源） ===== -->
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.PackVisible, Mode=OneWay}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="整合包" Style="{ThemeResource SubtitleTextBlockStyle}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="下载源" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox x:Name="PackSourceBox" MinWidth="150" IsEditable="False"
                                              SelectedIndex="0"
                                              SelectionChanged="PackSource_SelectionChanged">
                                        <ComboBoxItem Content="橙猫服官方" Tag="official" />
                                        <ComboBoxItem Content="Modrinth" Tag="modrinth" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="安装会自动解压、配置并设为当前版本；也可以只把源文件下载到本地自行处理。"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <ListView Grid.Row="2" x:Name="PackList"
                                      ItemsSource="{x:Bind ViewModel.Packs, Mode=OneWay}"
                                      SelectionMode="Single"
                                      SelectionChanged="PackList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="services:DownloadableVersion">
                                        <Grid ColumnSpacing="10" Padding="2,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind MainText}"
                                                           FontSize="15" FontWeight="Bold"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Note}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="已安装"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                       Visibility="{x:Bind InstalledVisibility, Mode=OneTime}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Grid Grid.Row="3" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="安装并设为当前版本"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Height="42"
                                        Click="DownloadPack_Click" />
                                <Button Grid.Column="1"
                                        Content="仅下载源文件…"
                                        MinWidth="150"
                                        Height="42"
                                        Click="SavePackSource_Click" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ===== 浏览面板：模组 / 资源包 / 光影 / Modrinth 整合包 ===== -->
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.ContentVisible, Mode=OneWay}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 列表视图（非详情状态） -->
                            <Grid Grid.Row="0" Grid.RowSpan="3" Visibility="{x:Bind ViewModel.ListVisible, Mode=OneWay}">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind ViewModel.ContentHeaderText, Mode=OneWay}"
                                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                                            <TextBlock x:Name="ContentContextText"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Top"
                                                    Visibility="{x:Bind ViewModel.IsPackSection, Mode=OneWay}">
                                            <TextBlock Text="下载源" FontSize="12.5" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <ComboBox x:Name="PackSourceBoxModrinth" MinWidth="150" IsEditable="False"
                                                      SelectedIndex="1"
                                                      SelectionChanged="PackSource_SelectionChanged">
                                                <ComboBoxItem Content="橙猫服官方" Tag="official" />
                                                <ComboBoxItem Content="Modrinth" Tag="modrinth" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SearchBox"
                                                 PlaceholderText="搜索项目名称..."
                                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                                                 KeyDown="SearchBox_KeyDown" />
                                        <Button Grid.Column="1" Content="搜索" Height="34" MinWidth="72" Click="Search_Click" />
                                        <Button Grid.Column="2" Content="{x:Bind ViewModel.TranslateButtonText, Mode=OneWay}" Height="34" MinWidth="84" Click="Translate_Click" />
                                    </Grid>

                                    <!-- 筛选：类别 / 版本 / 加载器（等宽三列，避免宽度参差） -->
                                    <Grid Grid.Row="2" ColumnSpacing="10" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" MinWidth="0" IsEditable="False"
                                                  HorizontalAlignment="Stretch"
                                                  Header="类别"
                                                  ItemsSource="{x:Bind ViewModel.FilterCategories, Mode=OneWay}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind ViewModel.FilterCategory, Mode=TwoWay}" />
                                        <ComboBox Grid.Column="1" MinWidth="0" IsEditable="False"
                                                  HorizontalAlignment="Stretch"
                                                  Header="游戏版本"
                                                  Visibility="{x:Bind ViewModel.VersionFilterVisible, Mode=OneWay}"
                                                  ItemsSource="{x:Bind ViewModel.FilterVersions, Mode=OneWay}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind ViewModel.FilterVersion, Mode=TwoWay}" />
                                        <ComboBox Grid.Column="2" MinWidth="0" IsEditable="False"
                                                  HorizontalAlignment="Stretch"
                                                  Header="模组加载器"
                                                  Visibility="{x:Bind ViewModel.IsModSection, Mode=OneWay}"
                                                  ItemsSource="{x:Bind ViewModel.FilterLoaders, Mode=OneWay}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{x:Bind ViewModel.FilterLoader, Mode=TwoWay}" />
                                    </Grid>

                                    <ListView Grid.Row="3" x:Name="ContentList"
                                              ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                                              SelectionMode="Single"
                                              IsItemClickEnabled="True"
                                              ItemClick="ContentList_ItemClick">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="services:ModrinthProjectItem">
                                                <Grid ColumnSpacing="10" Padding="2,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40" CornerRadius="8"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            VerticalAlignment="Top">
                                                        <Image Source="{x:Bind local:VersionDownloadPage.UrlToImage(IconUri)}"
                                                               Width="40" Height="40"
                                                               Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                                                   FontSize="15" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind DisplayDescription, Mode=OneWay}"
                                                                   FontSize="11.5"
                                                                   MaxLines="2"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind DownloadsText}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <!-- 分页 -->
                                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <Button x:Name="PrevPageButton" Content="上一页" Height="32" MinWidth="72" Click="PrevPage_Click" />
                                        <TextBlock Text="{x:Bind ViewModel.PageText, Mode=OneWay}"
                                                   VerticalAlignment="Center" FontSize="12.5" />
                                        <Button x:Name="NextPageButton" Content="下一页" Height="32" MinWidth="72" Click="NextPage_Click" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- 详情视图 -->
                            <Grid Grid.Row="0" Grid.RowSpan="3" Visibility="{x:Bind ViewModel.DetailVisible, Mode=OneWay}">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                                        <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Width="34" Height="34"
                                                Click="BackToResults_Click" ToolTipService.ToolTip="返回列表" />
                                        <TextBlock Text="{x:Bind ViewModel.DetailTitleText, Mode=OneWay}"
                                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="{x:Bind ViewModel.DetailDescriptionText, Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               MaxLines="3"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <Grid Grid.Row="2" RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <ComboBox Grid.Row="0" x:Name="VersionGroupBox"
                                                  Header="游戏版本"
                                                  MinWidth="240"
                                                  HorizontalAlignment="Left"
                                                  IsEditable="False"
                                                  ItemsSource="{x:Bind ViewModel.ProjectVersionGroups, Mode=OneWay}"
                                                  DisplayMemberPath="Display"
                                                  SelectedItem="{x:Bind ViewModel.SelectedVersionGroup, Mode=TwoWay}" />

                                        <ListView Grid.Row="1" x:Name="VersionList"
                                                  ItemsSource="{x:Bind ViewModel.GroupFiles, Mode=OneWay}"
                                                  SelectionMode="Single"
                                                  SelectionChanged="VersionList_SelectionChanged">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="services:ModrinthVersionItem">
                                                    <Grid ColumnSpacing="8" Padding="2,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Display}"
                                                                   FontSize="13"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <Border Grid.Column="1"
                                                                CornerRadius="8"
                                                                Padding="7,2"
                                                                VerticalAlignment="Center"
                                                                BorderThickness="1"
                                                                Background="{ThemeResource McOrangeFaintBrush}"
                                                                BorderBrush="{ThemeResource InfoTagBorderBrush}">
                                                            <TextBlock Text="{x:Bind ChannelText}"
                                                                       FontSize="11"
                                                                       Foreground="{ThemeResource InfoTagTextBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>

                                    <Grid Grid.Row="3" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 模组 / 资源包 / 光影：下载到指定位置 -->
                                        <Button Grid.ColumnSpan="2"
                                                Content="浏览…（选择保存位置并下载）"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Height="42"
                                                Visibility="{x:Bind ViewModel.BrowseOnlyVisible, Mode=OneWay}"
                                                Click="BrowseInstall_Click" />

                                        <!-- 整合包：安装到本地 -->
                                        <Button Content="安装整合包"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Height="42"
                                                Visibility="{x:Bind ViewModel.IsPackSection, Mode=OneWay}"
                                                Click="InstallPack_Click" />

                                        <!-- 整合包：仅下载源文件 -->
                                        <Button Grid.Column="1"
                                                Content="仅下载源文件…"
                                                MinWidth="150"
                                                Height="42"
                                                Visibility="{x:Bind ViewModel.IsPackSection, Mode=OneWay}"
                                                Click="BrowseInstall_Click" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- 下载进度对话框：进度条 + 阶段文字 + 速度/剩余时间 + 取消按钮 -->
        <ContentDialog x:Name="DownloadDialog"
                       Title="正在下载"
                       PrimaryButtonText="取消"
                       DefaultButton="Primary"
                       CloseButtonText="">
            <StackPanel Spacing="12" MinWidth="380" Margin="0,8">
                <TextBlock x:Name="DialogFileName"
                           FontSize="16" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="DialogProgress" Maximum="100" />
                <TextBlock x:Name="DialogProgressText"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- 最近下载的文件（实时滚动，最多 5 行） -->
                <TextBlock x:Name="DialogDetailText"
                           FontSize="11"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
