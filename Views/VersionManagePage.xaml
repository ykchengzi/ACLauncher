<Page
    x:Class="ACLauncher.Views.VersionManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ACLauncher.Views"
    xmlns:viewmodels="using:ACLauncher.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,18,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：返回 + 图标 + 版本名 + 渠道标签 + 当前标记 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Width="36" Height="36"
                    Click="Back_Click" ToolTipService.ToolTip="返回选择版本" />
            <Image Grid.Column="1" Width="38" Height="38" Stretch="Uniform"
                   VerticalAlignment="Center"
                   Source="{x:Bind local:BlockIcons.Load(ViewModel.IconFile), Mode=OneWay}"
                   ToolTipService.ToolTip="{x:Bind ViewModel.ChannelLabel, Mode=OneWay}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Rectangle Style="{StaticResource PageTitleAccentBar}" />
                <TextBlock Text="版本管理" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.VersionName, Mode=OneWay}"
                           FontSize="15" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.ChannelLabel, Mode=OneWay}"
                               FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{x:Bind local:XamlHelpers.ChannelBrush(ViewModel.ChannelLabel), Mode=OneWay}" />
                </Border>
            </StackPanel>
            <Border Grid.Column="3" VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="9,3"
                    Visibility="{x:Bind ViewModel.CurrentBadgeVisibility, Mode=OneWay}">
                <TextBlock Text="当前版本" FontSize="12"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Border>
        </Grid>

        <!-- 三个标签页：概览 / 管理 / 模组 -->
        <TabView Grid.Row="1" x:Name="Tabs"
                 IsAddTabButtonVisible="False"
                 CanReorderTabs="False">

            <!-- ===== 概览 ===== -->
            <TabViewItem Header="概览" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <StackPanel Spacing="14">

                        <!-- 概要卡片 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{x:Bind ViewModel.VersionName, Mode=OneWay}"
                                           FontSize="24" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{ThemeResource McOrangeFaintBrush}"
                                            BorderBrush="{ThemeResource InfoTagBorderBrush}" BorderThickness="1"
                                            CornerRadius="9" Padding="9,3">
                                        <TextBlock Text="{x:Bind ViewModel.LoaderLabel, Mode=OneWay}" FontSize="12"
                                                   Foreground="{ThemeResource McOrangeDeepBrush}" />
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="9" Padding="9,3">
                                        <TextBlock Text="{x:Bind ViewModel.SizeText, Mode=OneWay}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="9" Padding="9,3">
                                        <TextBlock Text="{x:Bind ViewModel.FilesText, Mode=OneWay}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.PathText, Mode=OneWay}"
                                           Style="{StaticResource LabelStyle}"
                                           IsTextSelectionEnabled="True"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- 内容统计 -->
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="模组" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.ModsText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="存档" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SavesText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="所需 Java" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.JavaText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 常用操作 -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="操作" FontSize="14" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="0" Content="打开版本文件夹" Height="40"
                                            HorizontalAlignment="Stretch" Click="OpenVersionFolder_Click" />
                                    <Button Grid.Row="0" Grid.Column="1" Content="打开 mods 文件夹" Height="40"
                                            HorizontalAlignment="Stretch" Click="OpenModsFolder_Click" />
                                    <Button Grid.Row="1" Grid.Column="0" Content="打开存档文件夹" Height="40"
                                            HorizontalAlignment="Stretch" Click="OpenSavesFolder_Click" />
                                    <Button Grid.Row="1" Grid.Column="1" Content="复制版本路径" Height="40"
                                            HorizontalAlignment="Stretch" Click="CopyPath_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ===== 管理（加载器） ===== -->
            <TabViewItem Header="管理" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <StackPanel Spacing="14">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="模组加载器" FontSize="16" FontWeight="SemiBold" />

                                <!-- 当前状态 -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="当前：" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                    <Border Background="{ThemeResource McOrangeFaintBrush}"
                                            BorderBrush="{ThemeResource InfoTagBorderBrush}" BorderThickness="1"
                                            CornerRadius="9" Padding="9,2">
                                        <TextBlock FontSize="12" Foreground="{ThemeResource McOrangeDeepBrush}">
                                            <Run Text="{x:Bind ViewModel.LoaderLabel, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{x:Bind ViewModel.LoaderVersionText, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Header="加载器"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.LoaderKinds, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedLoaderKind, Mode=TwoWay}" />
                                    <ComboBox Grid.Column="1"
                                              Header="加载器版本"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.LoaderVersions, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedLoaderVersion, Mode=TwoWay}" />
                                </Grid>

                                <Button Content="安装 / 更换加载器"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Height="42"
                                        IsEnabled="{x:Bind ViewModel.InstallLoaderEnabled, Mode=OneWay}"
                                        Click="InstallLoader_Click" />

                                <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingLoaders, Mode=OneWay}"
                                              Width="20" Height="20" HorizontalAlignment="Left" />

                                <TextBlock Text="{x:Bind ViewModel.LoaderActionStatus, Mode=OneWay}"
                                           Style="{StaticResource HintStyle}" />

                                <TextBlock Text="安装或更换加载器会新建一个独立的版本目录，不会覆盖当前版本；安装完成后可在“选择版本”页切换到新版本。"
                                           Style="{StaticResource HintStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ===== 模组 ===== -->
            <TabViewItem Header="模组" IsClosable="False">
                <Grid RowSpacing="12" Padding="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 未安装加载器：提示 + 去安装 -->
                    <Border Style="{StaticResource CardStyle}"
                            VerticalAlignment="Top"
                            Visibility="{x:Bind local:XamlHelpers.Collapsed(ViewModel.HasLoader), Mode=OneWay}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="当前版本未安装模组加载器，或者说你可能选择了一个不正确的版本。"
                                       TextWrapping="Wrap"
                                       FontSize="14" />
                            <TextBlock Text="没有加载器时游戏不会读取 mods 目录里的模组。可以先安装 Fabric / Quilt / Forge / NeoForge 后再添加模组。"
                                       Style="{StaticResource HintStyle}" />
                            <Button Content="去安装"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    MinWidth="120" Height="40"
                                    HorizontalAlignment="Left"
                                    Click="GoInstallLoader_Click" />
                        </StackPanel>
                    </Border>

                    <!-- 已安装加载器：模组列表 -->
                    <Border Style="{StaticResource CardStyle}"
                            Visibility="{x:Bind local:XamlHelpers.Visible(ViewModel.HasLoader), Mode=OneWay}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock Text="已安装的模组" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="这里只列出 mods 目录下的 .jar 文件；停用或删除后下次启动生效。"
                                           Style="{StaticResource HintStyle}" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <ListView ItemsSource="{x:Bind ViewModel.Mods, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedMod, Mode=TwoWay}"
                                          SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:InstalledModItem">
                                            <Grid ColumnSpacing="10" Padding="2,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind FileName}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind SizeText}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="mods 目录还是空的，去下载页挑几个模组吧。"
                                           Style="{StaticResource HintStyle}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind ViewModel.ModsEmptyVisibility, Mode=OneWay}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 模组操作 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10"
                                Visibility="{x:Bind local:XamlHelpers.Visible(ViewModel.HasLoader), Mode=OneWay}">
                        <Button Content="去下载模组" Height="40" MinWidth="120" Click="GoDownloadMods_Click" />
                        <Button Content="打开 mods 文件夹" Height="40" MinWidth="140" Click="OpenModsFolder_Click" />
                        <Button Content="删除所选模组" Height="40" MinWidth="132"
                                IsEnabled="{x:Bind ViewModel.CanDeleteMod, Mode=OneWay}"
                                Click="DeleteMod_Click" />
                    </StackPanel>
                </Grid>
            </TabViewItem>
        </TabView>

        <!-- 底部主操作 -->
        <StackPanel Grid.Row="2" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="{x:Bind ViewModel.SetCurrentButtonText, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Height="46"
                        IsEnabled="{x:Bind ViewModel.SetCurrentEnabled, Mode=OneWay}"
                        Click="SetCurrent_Click" />
                <Button Grid.Column="1" Content="删除此版本" Height="46" MinWidth="140"
                        Click="Delete_Click" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
