<Page
    x:Class="ACLauncher.Views.VersionManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,18,24,16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：返回 + 版本名 + 当前标记 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Width="36" Height="36"
                    Click="Back_Click" ToolTipService.ToolTip="返回选择版本" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Rectangle Style="{StaticResource PageTitleAccentBar}" />
                <TextBlock Text="版本管理" Style="{ThemeResource TitleTextBlockStyle}" />
            </StackPanel>
            <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="9,3"
                    Visibility="{x:Bind ViewModel.CurrentBadgeVisibility, Mode=OneWay}">
                <TextBlock Text="当前版本" FontSize="12"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="14">

                <!-- 概要卡片：版本名 + 加载器 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.VersionName, Mode=OneWay}"
                                   FontSize="24" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource McOrangeFaintBrush}"
                                    BorderBrush="{ThemeResource InfoTagBorderBrush}" BorderThickness="1"
                                    CornerRadius="9" Padding="9,3">
                                <TextBlock Text="{x:Bind ViewModel.LoaderLabel, Mode=OneWay}" FontSize="12"
                                           Foreground="{ThemeResource McOrangeDeepBrush}" />
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="9" Padding="9,3">
                                <TextBlock Text="{x:Bind ViewModel.SizeText, Mode=OneWay}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="9" Padding="9,3">
                                <TextBlock Text="{x:Bind ViewModel.FilesText, Mode=OneWay}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.PathText, Mode=OneWay}"
                                   Style="{StaticResource LabelStyle}"
                                   IsTextSelectionEnabled="True"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- 内容统计 -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="模组" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ModsText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="存档" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SavesText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="所需 Java" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.JavaText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 常用操作 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="操作" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="打开版本文件夹" Height="40"
                                    HorizontalAlignment="Stretch" Click="OpenVersionFolder_Click" />
                            <Button Grid.Row="0" Grid.Column="1" Content="打开 mods 文件夹" Height="40"
                                    HorizontalAlignment="Stretch" Click="OpenModsFolder_Click" />
                            <Button Grid.Row="1" Grid.Column="0" Content="打开存档文件夹" Height="40"
                                    HorizontalAlignment="Stretch" Click="OpenSavesFolder_Click" />
                            <Button Grid.Row="1" Grid.Column="1" Content="复制版本路径" Height="40"
                                    HorizontalAlignment="Stretch" Click="CopyPath_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部主操作 -->
        <StackPanel Grid.Row="2" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="{x:Bind ViewModel.SetCurrentButtonText, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Height="46"
                        IsEnabled="{x:Bind ViewModel.SetCurrentEnabled, Mode=OneWay}"
                        Click="SetCurrent_Click" />
                <Button Grid.Column="1" Content="删除此版本" Height="46" MinWidth="140"
                        Click="Delete_Click" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
