<Page
    x:Class="ACLauncher.Views.SelectVersionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:ACLauncher.ViewModels"
    xmlns:local="using:ACLauncher.Views"
    mc:Ignorable="d">

    <Grid Padding="24,18,24,14" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题区 + 搜索 -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Rectangle Style="{StaticResource PageTitleAccentBar}" />
                    <TextBlock Text="选择版本" Style="{ThemeResource TitleTextBlockStyle}" />
                </StackPanel>
                <TextBlock Text="点按选中，右键进入版本管理"
                           FontSize="12"
                           Margin="15,0,0,0"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            <TextBox x:Name="SearchBox"
                     Grid.Column="1"
                     Width="288"
                     VerticalAlignment="Center"
                     PlaceholderText="搜索版本名 / Minecraft 版本 / 加载器"
                     TextChanged="SearchBox_TextChanged" />
        </Grid>

        <!-- 版本卡片：三栏，撑满宽度 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Versions, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MaximumRowsOrColumns="3"
                                       ItemsStretch="Fill"
                                       MinItemWidth="220"
                                       MinItemHeight="122"
                                       MinColumnSpacing="12"
                                       MinRowSpacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:InstalledVersionItem">
                        <Button Tag="{x:Bind Id}"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                BorderThickness="0"
                                Background="Transparent"
                                Click="VersionCard_Click"
                                DoubleTapped="VersionCard_DoubleTapped"
                                RightTapped="VersionCard_RightTapped">
                            <Border Padding="16,14"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    Background="{x:Bind local:SelectVersionPage.GetCardBackground(IsSelected), Mode=OneWay}"
                                    BorderBrush="{x:Bind local:SelectVersionPage.GetCardBorder(IsSelected), Mode=OneWay}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 第一行：方块图标 + 版本名 + 渠道标签 + 当前 -->
                                <Grid Grid.Row="0" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="34" Height="34"
                                           VerticalAlignment="Top"
                                           Stretch="Uniform"
                                           Source="{x:Bind local:BlockIcons.Load(IconFile), Mode=OneTime}" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{x:Bind Id}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border HorizontalAlignment="Left"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="7" Padding="7,1">
                                            <TextBlock Text="{x:Bind ChannelLabel}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{x:Bind local:XamlHelpers.ChannelBrush(ChannelLabel), Mode=OneTime}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="当前"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{ThemeResource McOrangeDeepBrush}"
                                               Visibility="{x:Bind CurrentVisibility, Mode=OneWay}" />
                                </Grid>

                                <!-- 第二行：Minecraft 版本 · 加载器 -->
                                <TextBlock Grid.Row="1"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="Minecraft " /><Run Text="{x:Bind MinecraftVersion}" /><Run Text=" · " /><Run Text="{x:Bind LoaderLabel}" />
                                </TextBlock>

                                <!-- 第三行：大小 · 模组数 -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind SizeText}"
                                               FontSize="11.5"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="·" FontSize="11.5"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Visibility="{x:Bind ModsVisibility}" />
                                    <TextBlock Text="{x:Bind ModsText}"
                                               FontSize="11.5"
                                               Visibility="{x:Bind ModsVisibility}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- 底部操作栏：左状态、右按钮（不再是横贯全屏的大色块） -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Content="设为当前版本"
                        Style="{ThemeResource AccentButtonStyle}"
                        Height="40"
                        MinWidth="132"
                        Command="{x:Bind ViewModel.SelectCommand}" />
                <Button Content="删除所选版本"
                        Height="40"
                        MinWidth="116"
                        Click="DeleteButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
